#version 450

// ocarina_dlss_4k_reference.comp for a game presenting HDR10: the 1440p scene stays linear and
// unclamped, for ocarina_dlss_4k_composite_hdr.comp.

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D guest_scene;
layout(binding = 1, rgba16f) uniform writeonly image2D reference_color;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(reference_color)))) {
        return;
    }
    vec3 linear = max(texelFetch(guest_scene, pixel, 0).rgb, vec3(0.0));
    imageStore(reference_color, pixel, vec4(linear, 1.0));
}
